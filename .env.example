# Public application settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://ovvezqqdkqcqselwulvl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Register as a Cloudflare Worker secret for admin/sync jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Optional ingestion/enrichment services
TMDB_BEARER_TOKEN=
YOUTUBE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# AI enrichment is disabled unless both caps are greater than zero.
EMOTION_AI_MAX_MOVIES=0
EMOTION_AI_MAX_COST_USD=0
CRON_SECRET=
RAPIDAPI_TIKTOK_KEY=
TIKTOK_RAPIDAPI_PROVIDER=tokapi-mobile
TIKTOK_RAPIDAPI_HOST=tokapi-mobile-version.p.rapidapi.com
TIKTOK_RAPIDAPI_ENDPOINT=https://tokapi-mobile-version.p.rapidapi.com/v1/search/post
TIKTOK_SYNC_TITLE_LIMIT=3
TIKTOK_SYNC_CANDIDATE_POOL_LIMIT=90
TIKTOK_SYNC_POSTS_PER_TITLE=10
TIKTOK_SYNC_MAX_PAGES_PER_TITLE=1
TIKTOK_SYNC_MIN_VIEWS=500

# Optional authenticated Playwright test user
E2E_TEST_USER_EMAIL=kibun-e2e-test@example.com

# Optional sync controls
SYNC_MAX_PAGES=2
SYNC_CONCURRENCY=3
# Comma-separated: discover,popular,now_playing,upcoming,trending,japan,korea
SYNC_SOURCES=discover,popular,now_playing,upcoming,trending,japan,korea
SYNC_MEDIA_TYPES=movie,tv
# Set false for a locale-only backfill that should not refresh every tracked movie.
SYNC_REFRESH_TRACKED=true
SYNC_RUN_SOURCE=tmdb-local-catalog
SYNC_RELEASE_DATE_FROM=
SYNC_RELEASE_DATE_TO=
